{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://versuscypher.com/schemas/fx/adapter-capability-v1.schema.json",
  "title": "Versus FX EVM adapter capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "adapter", "build", "capabilities"],
  "properties": {
    "schema": { "const": "versus-fx-adapter-capabilities" },
    "schemaVersion": { "const": 1 },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contract", "sourcePath"],
      "properties": {
        "id": { "const": "evm-htlc" },
        "version": { "const": 1 },
        "contract": { "const": "EvmHtlcV1" },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "evmVersion",
        "sourceTag",
        "optimizerRuns",
        "viaIR",
        "sourceSha256",
        "creationCodeHash"
      ],
      "properties": {
        "compiler": { "type": "string", "minLength": 1 },
        "evmVersion": { "type": "string", "minLength": 1 },
        "sourceTag": { "const": "agentic-fx-phase3-v1" },
        "optimizerRuns": { "type": "integer", "minimum": 0 },
        "viaIR": { "const": true },
        "sourceSha256": { "$ref": "#/$defs/hash" },
        "creationCodeHash": { "$ref": "#/$defs/hash" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "adapterAddress",
        "runtimeCodeHash",
        "asset",
        "confirmationPolicy",
        "timeoutPolicy"
      ],
      "properties": {
        "chainId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "adapterAddress": { "$ref": "#/$defs/address" },
        "runtimeCodeHash": { "$ref": "#/$defs/hash" },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "runtimeCodeHash",
            "symbol",
            "decimals",
            "standard",
            "features"
          ],
          "properties": {
            "address": { "$ref": "#/$defs/address" },
            "runtimeCodeHash": { "$ref": "#/$defs/hash" },
            "symbol": { "type": "string", "minLength": 1 },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
            "standard": { "const": "ERC20" },
            "features": {
              "type": "object",
              "additionalProperties": false,
              "required": ["feeOnTransfer", "rebasing", "callbacks", "issuerControls"],
              "properties": {
                "feeOnTransfer": { "const": false },
                "rebasing": { "const": false },
                "callbacks": { "const": false },
                "issuerControls": { "enum": ["none", "documented"] }
              }
            }
          }
        },
        "confirmationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredConfirmations", "reorgSafetyBlocks"],
          "properties": {
            "requiredConfirmations": { "type": "integer", "minimum": 1 },
            "reorgSafetyBlocks": { "type": "integer", "minimum": 1 }
          }
        },
        "timeoutPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumSeconds",
            "maximumSeconds",
            "minimumCrossChainDeltaSeconds"
          ],
          "properties": {
            "minimumSeconds": { "type": "integer", "minimum": 1 },
            "maximumSeconds": { "type": "integer", "minimum": 2 },
            "minimumCrossChainDeltaSeconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
