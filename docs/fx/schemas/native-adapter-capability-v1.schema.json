{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://versuscypher.com/schemas/fx/native-adapter-capability-v1.schema.json",
  "title": "Versus FX native EVM adapter capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "adapter", "build", "capabilities"],
  "properties": {
    "schema": { "const": "versus-fx-native-adapter-capabilities" },
    "schemaVersion": { "const": 1 },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contract", "sourcePath"],
      "properties": {
        "id": { "const": "evm-native-htlc" },
        "version": { "const": 1 },
        "contract": { "const": "EvmNativeHtlcV1" },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "evmVersion", "sourceTag", "optimizerRuns", "viaIR", "sourceSha256", "creationCodeHash"],
      "properties": {
        "compiler": { "type": "string", "minLength": 1 },
        "evmVersion": { "type": "string", "minLength": 1 },
        "sourceTag": { "const": "agentic-fx-native-v1" },
        "optimizerRuns": { "type": "integer", "minimum": 0 },
        "viaIR": { "const": true },
        "sourceSha256": { "$ref": "#/$defs/hash" },
        "creationCodeHash": { "$ref": "#/$defs/hash" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chainId", "adapterAddress", "runtimeCodeHash", "deploymentBlock", "asset", "confirmationPolicy", "timeoutPolicy"],
        "properties": {
          "chainId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "adapterAddress": { "$ref": "#/$defs/address" },
          "runtimeCodeHash": { "$ref": "#/$defs/hash" },
          "deploymentBlock": { "type": "integer", "minimum": 1 },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetId", "symbol", "decimals", "standard"],
            "properties": {
              "assetId": { "const": "native:eth" },
              "symbol": { "const": "ETH" },
              "decimals": { "const": 18 },
              "standard": { "const": "NATIVE" }
            }
          },
          "confirmationPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requiredConfirmations", "reorgSafetyBlocks"],
            "properties": {
              "requiredConfirmations": { "type": "integer", "minimum": 1 },
              "reorgSafetyBlocks": { "type": "integer", "minimum": 1 }
            }
          },
          "timeoutPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumSeconds", "maximumSeconds", "minimumCrossChainDeltaSeconds"],
            "properties": {
              "minimumSeconds": { "type": "integer", "minimum": 1 },
              "maximumSeconds": { "type": "integer", "minimum": 2 },
              "minimumCrossChainDeltaSeconds": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
  }
}
