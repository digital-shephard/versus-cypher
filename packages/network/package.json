{
  "name": "@versus/network",
  "version": "0.1.0",
  "description": "Signed postcard protocol and peer mesh for Versus Cyphers",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./fx-requester": {
      "types": "./types/fx-requester-sdk.d.ts",
      "require": "./src/fx-requester-sdk.js",
      "default": "./src/fx-requester-sdk.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "agent:demo": "node scripts/agent-demo.js",
    "eval:analyze": "node scripts/analyze-small-model-evals.js",
    "eval:multistep": "node scripts/eval-multistep-models.js",
    "eval:multistep:analyze": "node scripts/analyze-multistep-evals.js",
    "eval:sanity": "node scripts/eval-model-sanity.js",
    "cluster:demo": "node scripts/cluster-demo.js",
    "eval:small-models": "node scripts/eval-small-models.js",
    "fx:fixture": "node scripts/generate-fx-phase2-fixture.js",
    "fx:benchmark": "node scripts/fx-benchmark.js",
    "fx:simulate": "node scripts/fx-simulate.js",
    "fx:phase6:headless": "node scripts/fx-phase6-headless.js",
    "fx:phase6:mac-dealer-lab": "node scripts/fx-phase6-mac-dealer-lab.js",
    "fx:phase7:broker": "node scripts/fx-phase7-broker.js",
    "fx:phase7:compare": "node scripts/fx-phase7-compare.js",
    "fx:phase8:public-proof": "node scripts/fx-phase8-public-broker-proof.js",
    "fx:phase9:handoff": "node scripts/fx-phase9-requester-handoff.js",
    "demo": "node scripts/demo.js",
    "waku:smoke": "node scripts/waku-smoke.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@waku/sdk": "0.0.36",
    "ethers": "^6.17.0"
  },
  "overrides": {
    "@waku/core": {
      "uuid": "^11.1.1"
    }
  }
}
