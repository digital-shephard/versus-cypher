{
  "name": "versus-contracts",
  "version": "0.1.0",
  "description": "Versus — daily agent nest-egg arena on Base",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:invariants": "hardhat test test/invariants/VersusInvariants.fuzz.js",
    "test:invariants:long": "hardhat test test/invariants/VersusInvariants.fuzz.js",
    "test:forge": "forge test --match-contract VersusInvariants -vv",
    "test:forge:deep": "FOUNDRY_PROFILE=deep forge test --match-contract VersusInvariants -vv",
    "test:fx:phase3": "hardhat test test/fx/EvmHtlcV1.test.js test/fx/EvmAdapterPreflight.test.js test/fx/EvmBuildFreeze.test.js",
    "test:fx:phase3:forge": "forge test --match-path 'forge-test/EvmHtlcV1*.t.sol' -vv",
    "test:fx:phase3:forge:deep": "FOUNDRY_PROFILE=deep forge test --match-path 'forge-test/EvmHtlcV1*.t.sol' -vv",
    "test:fx:phase5:protocol": "node --test ../packages/network/test/fx-phase5.test.js",
    "test:fx:phase5:local": "node scripts/fx/run-phase5-dual-chain-lab.js",
    "fx:phase5:preflight": "node scripts/fx/preflight-phase5-testnets.js",
    "fx:phase5:identities": "node scripts/fx/create-phase5-test-identities.js",
    "fx:phase5:deploy": "node scripts/fx/deploy-phase5-testnet.js",
    "fx:phase5:routes": "node scripts/fx/assemble-phase5-testnet-route.js",
    "fx:phase5:scenario": "node scripts/fx/run-phase5-testnet-scenario.js",
    "fx:freeze:evm-v1": "hardhat compile && node scripts/fx/freeze-evm-htlc-v1.js",
    "fx:freeze:evm-native-v1": "hardhat compile && node scripts/fx/freeze-evm-native-htlc-v1.js",
    "fx:deploy:native:base-sepolia": "hardhat compile && node scripts/fx/deploy-evm-native-htlc-v1.js base-sepolia",
    "fx:deploy:native:arbitrum-sepolia": "hardhat compile && node scripts/fx/deploy-evm-native-htlc-v1.js arbitrum-sepolia",
    "fx:assemble:native-testnet": "node scripts/fx/assemble-phase9-native-testnet.js",
    "fx:verify:native:base-sepolia": "hardhat run scripts/fx/verify-evm-native-htlc-v1.js --network baseSepolia",
    "fx:verify:native:arbitrum-sepolia": "hardhat run scripts/fx/verify-evm-native-htlc-v1.js --network arbitrumSepolia",
    "fx:deploy:local": "hardhat run scripts/fx/deploy-evm-htlc-v1.js --network localhost",
    "fx:verify:evm-v1": "hardhat run scripts/fx/verify-evm-htlc-v1.js",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:base-fork": "node scripts/run-base-fork-rehearsal.js",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:hardhat": "hardhat run scripts/deploy.js",
    "simulate": "hardhat run scripts/simulate.js",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "preflight:base": "hardhat run scripts/check-base-production.js",
    "freeze:base-build": "hardhat run scripts/freeze-base-build.js",
    "verify:base": "hardhat run scripts/verify-base.js --network base",
    "audit:base": "node scripts/audit-base-deployment.js",
    "test:all": "node ../scripts/test-all.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "ajv": "8.17.1",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "dotenv": "^16.3.1"
  }
}
